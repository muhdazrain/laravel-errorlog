{
    "name": "azrain/laravel-errorlog",
    "description": "Simple self-hosted error monitoring for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Azrain\\LaravelErrorLog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Azrain\\LaravelErrorLog\\LaravelErrorLogServiceProvider"
            ],
            "aliases": {
                "ErrorLog": "Azrain\\LaravelErrorLog\\Facades\\ErrorLog"
            }
        }
    },
    "minimum-stability": "stable"
}